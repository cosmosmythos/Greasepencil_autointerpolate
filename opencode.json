{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "Addon/AGENTS.md", "Addon/core/AGENTS.md", "Executable/AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "blender": {
      "type": "local",
      "command": ["uvx", "blender-mcp"],
      "enabled": true,
      "environment": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  },
  "agent": {
    "build": {
      "description": "Build agent with DOX framework enforcement. Always reads AGENTS.md chain before editing.",
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    }
  }
}
